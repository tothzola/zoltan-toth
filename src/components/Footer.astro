---
import RainBackground from './RainBackground.astro';
import { site } from '../data/site';
import type { Dictionary, Locale } from '../i18n';

interface Props {
  lang: Locale;
  dict: Dictionary;
}

const { lang, dict } = Astro.props;
const footer = dict.footer;
const contacts = [
  { label: footer.linkedin, href: site.links.linkedin, external: true },
  { label: footer.github, href: site.links.github, external: true },
  { label: footer.email, href: site.links.email ? `mailto:${site.links.email}` : '', external: false },
];
const updated = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long' }).format(new Date());
---

<footer id="contact" class="site-footer">
  {site.codeRain && <RainBackground />}
  <div class="wrap">
    <h2>{footer.title}</h2>
    <p class="section-intro">{footer.text}</p>

    <ul class="contact-list">
      {
        contacts.map((contact) => (
          <li>
            {contact.href ? (
              contact.external ? (
                <a class="btn" href={contact.href} target="_blank" rel="me noopener noreferrer">
                  {contact.label}
                  <span class="btn-icon" aria-hidden="true">↗</span>
                  <span class="sr-only">{` (${footer.newTab})`}</span>
                </a>
              ) : (
                <a class="btn" href={contact.href} rel="me">
                  {contact.label}
                </a>
              )
            ) : (
              <span class="btn is-placeholder" title={footer.placeholder}>
                {contact.label}
              </span>
            )}
          </li>
        ))
      }
    </ul>

    <p class="footer-note">
      {footer.built}
      <span aria-hidden="true">·</span>
      {footer.updated}: {updated}
    </p>
  </div>
</footer>
